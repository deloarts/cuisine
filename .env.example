# ─────────────────────────────────────────────────────────────
# Cuisine production environment template
#
# Copy this file to .env (or a custom file referenced via ENV_FILE, e.g.
# stack.env for Portainer) and fill in real values before deploying with
# docker-compose.yml. A production backend refuses to start with the
# sample values below (boot_guard.py).
# ─────────────────────────────────────────────────────────────

# ── Release ─────────────────────────────────────────────────────────────
# Image tag pulled from GHCR. Required. Pin a minor (v0.1) so patch
# releases arrive on the next `docker compose pull`, or an exact tag.
CUISINE_VERSION=v0.1
# BACKEND_VERSION=
# FRONTEND_VERSION=

# Host interface and port the frontend is published on.
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=8080
# ENV_FILE=stack.env

# Subnets of the stack's two Docker networks (defaults shown).
# CUISINE_INTERNAL_SUBNET=192.168.250.0/24
# CUISINE_EXTERNAL_SUBNET=192.168.251.0/24
# Fixed addresses on the external network (defaults shown). The backend
# believes forwarded headers from the frontend's address only. A changed
# CUISINE_EXTERNAL_SUBNET needs all three set inside it.
# CUISINE_EXTERNAL_GATEWAY=192.168.251.1
# CUISINE_FRONTEND_IP=192.168.251.250
# CUISINE_CLOUDFLARED_IP=192.168.251.251
# Addresses or CIDR networks whose X-Forwarded-For the frontend's nginx
# believes, or "none". The default is the gateway, which a reverse proxy
# on the host connects through, and the cloudflared tunnel. Never list a
# network clients connect from.
# CUISINE_TRUSTED_PROXIES=192.168.251.1,192.168.251.251

# ── App ────────────────────────────────────────────────────────────────
# Must be false in production (secure cookies, no API docs, boot guard).
DEBUG=false
# Public URL the app is served from: CORS, cookies, passkeys and mail
# links. Passkeys are bound to its host name, so changing it later orphans
# every registered passkey.
DOMAIN=https://cuisine.example.com
LOG_LEVEL=INFO
# "text" for humans, "json" (one object per line) for a log aggregator.
LOG_FORMAT=text
# Gunicorn worker processes in the backend container.
# WEB_CONCURRENCY=2

# ── Database ───────────────────────────────────────────────────────────
DATABASE__URL=postgresql+psycopg://cuisine:change_me@postgres:5432/cuisine
# DATABASE__POOL_SIZE=5
# DATABASE__MAX_OVERFLOW=5

# Read by the postgres image and the backup sidecar.
POSTGRES_USER=cuisine
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cuisine

# Nightly dumps (docker-compose.yml, service "backup").
# BACKUP_DIR=/srv/cuisine/backups
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=3

# ── File storage ───────────────────────────────────────────────────────
# Where uploaded images and documents are kept: postgres (in the database,
# covered by the nightly dumps; the default), local (the `files` volume) or
# seaweedfs (the bundled S3 store, --profile seaweedfs). Changing it moves
# no file; see docs/OPERATIONS.md section 2.2 for the storage CLI.
STORAGE__PROVIDER=postgres
# For seaweedfs: the backend reaches it over the internal network, the
# browser through this deployment's own address, whose nginx serves
# /objects/. Use the same pair as SEAWEEDFS_ACCESS_KEY/SECRET_KEY below.
# STORAGE__ENDPOINT_URL=http://seaweedfs:8333
# STORAGE__PUBLIC_ENDPOINT_URL=https://cuisine.example.com
# STORAGE__BUCKET_NAME=objects
# STORAGE__ACCESS_KEY=cuisine
# STORAGE__SECRET_KEY=change_me

# ── SeaweedFS (optional, --profile seaweedfs) ──────────────────────────
# The bundled S3 store's own key pair. The secret needs at least 24
# characters; the profile refuses to start with the sample value.
# SEAWEEDFS_ACCESS_KEY=cuisine
# SEAWEEDFS_SECRET_KEY=change_me

# ── Redis ──────────────────────────────────────────────────────────────
REDIS__URL=redis://redis:6379/0

# ── Security (never commit real values) ────────────────────────────────
# Each needs at least 32 characters and they must differ.
# `openssl rand -hex 32` generates one.
# Signs the session tokens; changing it signs everybody out.
SECURITY__SECRET_KEY=change_me
# Encrypts TOTP secrets and the SMTP password in the database. Changing it
# makes them unreadable unless the old value is set as
# SECURITY__ENCRYPTION_KEY_PREVIOUS. Back it up apart from the database
# dumps: a restored dump needs the same key.
SECURITY__ENCRYPTION_KEY=change_me
# SECURITY__ENCRYPTION_KEY_PREVIOUS=

# ── System account ─────────────────────────────────────────────────────
# The system account, always named `system`. Created on the first start and
# synced back to these values on every start, so change its password here and
# restart; a password changed in the app lasts only until the next start. Its
# first sign-in sets up two-factor authentication, which is mandatory for it,
# and its sessions end 15 minutes after sign-in.
INIT__FULL_NAME=Administrator
INIT__MAIL=admin@example.com
INIT__PASSWORD=change_me

# ── Cloudflare Tunnel (--profile cloudflare) ───────────────────────────
# TUNNEL_TOKEN=
