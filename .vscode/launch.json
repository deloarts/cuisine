{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (uvicorn)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "preLaunchTask": "Backend server",
      "postDebugTask": "Stop backend server",
      "justMyCode": false,
      "subProcess": true
    },
    {
      "name": "Backend tests (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "${file}",
        "-q"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "npm run dev -- --host"
    },
    {
      "name": "Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": [
        "Backend (uvicorn)",
        "Frontend (Vite)"
      ],
      "preLaunchTask": "Start DB services"
    }
  ]
}
