{
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/.volumes": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "backend/openapi/*.json": true,
    "frontend/src/core/api/generated/**": true,
    ".local/**": true
  },
  "files.associations": { "*.Dockerfile": "dockerfile" },
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "eslint.workingDirectories": [{ "directory": "frontend", "changeProcessCWD": true }],
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "vitest.rootConfig": "frontend/vitest.config.ts",
  "python-envs.pythonProjects": [
    {
      "path": ".",
      "envManager": "ms-python.python:poetry",
      "packageManager": "ms-python.python:poetry"
    }
  ]
}
