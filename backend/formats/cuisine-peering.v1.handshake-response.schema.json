{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cuisine:protocol:cuisine-peering:1:handshake-response",
  "title": "cuisine-peering version 1: handshake-response",
  "type": "object",
  "description": "The answer to POST /handshake: the inviting instance's identity, the negotiated versions and the secret the accepting instance shall sign its requests with.",
  "properties": {
    "instance_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "base_url": {
      "type": "string"
    },
    "protocol_versions": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "protocol_version": {
      "type": "integer"
    },
    "format_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "secret": {
      "type": "string"
    },
    "app_version": {
      "type": "string"
    },
    "formats": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "instance_id",
    "name",
    "base_url",
    "protocol_versions",
    "protocol_version",
    "format_versions",
    "secret"
  ],
  "$defs": {}
}
