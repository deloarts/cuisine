// TSConfig for modules that run in Node.js via transpilation or type-stripping.
{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "vitest.setup.*",
    "eslint.config.*",
    "playwright.config.*",
    "e2e/**/*",
    "scripts/**/*"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
