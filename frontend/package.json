{
  "name": "cuisine-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE.md",
  "type": "module",
  "scripts": {
    "test:e2e": "docker run --rm --init --ipc=host --network host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -e E2E_BASE_URL -e E2E_API_URL -e E2E_ADMIN_PASSWORD -e E2E_ANNA_PASSWORD -e E2E_BEN_PASSWORD -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble npx playwright test",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:stylelint": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "lint:check": "run-s lint:check:*",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint .",
    "lint:check:stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "check:i18n": "jiti scripts/check-i18n-parity.ts",
    "generate:api-types": "jiti scripts/generate-api-types.ts",
    "check:api-types": "jiti scripts/generate-api-types.ts --check",
    "ci": "run-s type-check lint:check test:unit:run check:i18n check:api-types"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@openvue/themes": "1.0.0",
    "@tiptap/core": "3.32.3",
    "@tiptap/extension-mention": "3.32.3",
    "@tiptap/markdown": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "@tiptap/suggestion": "3.32.3",
    "@tiptap/vue-3": "3.32.3",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.7.8",
    "markdown-it": "15.0.3",
    "openvue": "1.0.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@openvue/auto-import-resolver": "1.0.0",
    "@playwright/test": "1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-vue": "~10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.89.0",
    "postcss-html": "^2.0.0",
    "sass-embedded": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.12.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
