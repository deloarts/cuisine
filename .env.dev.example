# ─────────────────────────────────────────────────────────────
# Cuisine development environment. Copy to .env.dev (make setup does).
# The values point at the dev compose services on localhost, for the host
# dev loop (make infra, make dev-backend).
# ─────────────────────────────────────────────────────────────

DEBUG=true
DOMAIN=http://localhost:5173
LOG_LEVEL=DEBUG
# Applies pending migrations when the dev server starts.
MIGRATE_ON_STARTUP=true

DATABASE__URL=postgresql+psycopg://cuisine:cuisine@localhost:5433/cuisine
POSTGRES_USER=cuisine
POSTGRES_PASSWORD=cuisine
POSTGRES_DB=cuisine

REDIS__URL=redis://localhost:6380/0

SECURITY__SECRET_KEY=dev-secret-key-not-for-production-use
SECURITY__ENCRYPTION_KEY=dev-encryption-key-not-for-production

INIT__FULL_NAME=Dev Admin
INIT__MAIL=admin@example.com
INIT__PASSWORD=admin-password

# File storage: postgres by default. For the seaweedfs provider start the
# dev store with --profile seaweedfs and uncomment these.
STORAGE__PROVIDER=postgres
# STORAGE__ENDPOINT_URL=http://localhost:8333
# STORAGE__PUBLIC_ENDPOINT_URL=http://localhost:8333
# STORAGE__ACCESS_KEY=cuisine
# STORAGE__SECRET_KEY=cuisine-dev-seaweedfs-secret
# The local provider writes here.
LOCAL_STORAGE__BASE_DIR=../.volumes/files
